{
  "name": "@drawcall/impostor-cli",
  "version": "0.1.0",
  "type": "module",
  "description": "Bake .glb/.gltf models into octahedral impostor .glts files from the command line, in plain Node.",
  "bin": {
    "impostor": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "pnpm build && vitest run"
  },
  "dependencies": {
    "@drawcall/impostor": "workspace:*",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "draco3dgltf": "^1.5.7",
    "meshoptimizer": "^1.3.0",
    "sharp": "^0.35.5",
    "three": "^0.185.1",
    "webgl-node": "1.6.1"
  },
  "devDependencies": {
    "@types/draco3dgltf": "^1.4.3",
    "@types/node": "^24.13.6",
    "@types/three": "^0.185.0"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drawcall-ai/impostor.git",
    "directory": "packages/cli"
  },
  "publishConfig": {
    "access": "public"
  }
}
