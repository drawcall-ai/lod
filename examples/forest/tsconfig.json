{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "vite/client",
      "node"
    ],
    "paths": {
      "@drawcall/impostor": [
        "../../packages/impostor/src/index.ts"
      ]
    }
  },
  "include": [
    "src",
    "scripts",
    "vite.config.ts"
  ]
}
