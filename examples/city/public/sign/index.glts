import { disposeRecursive, loadingManager, onDispose, scene } from "@drawcall/glts";
import { streetSign } from "./model.ts";

const text = new URL(import.meta.url).searchParams.get("text") ?? "Maple St";
const object = streetSign(loadingManager, text);
onDispose(() => disposeRecursive(scene));
scene.add(object);
