import { loadingManager, onDispose, scene } from "@drawcall/glts";
import { streetSign } from "../content/sign.ts";
import { Library } from "../content/materials.ts";

const library = new Library(loadingManager, new URL("../assets/", import.meta.url).href);
onDispose(() => library.dispose());
const query = new URL(import.meta.url).searchParams;
await library.load();
const object = library.own(streetSign(library, query.get("text") ?? "Maple St"));
scene.add(object);
await library.ready(object);
