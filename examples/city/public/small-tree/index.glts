import { isPreview, loadingManager, onDispose, scene } from "@drawcall/glts";
import { CachedLodLoader, foliageLevels, foliageModel, ImpostorMesh, Lod } from "@drawcall/lod";
import * as THREE from "three/webgpu";

// Poly Haven's small broadleaf tree at levels of detail: the scan nearby, simplified to 10 % of its leaf cards to
// 900 px, keeping the forked branches in geometry, then hemispherical impostors drawn at card depth: 256 px from 640 px
// with one parallax step, which keeps the trunk aligned across views as the camera passes, 128 px from 160 px and 16 px
// from 20 px. Its leaves are foliage. Every level casts and receives shadows, both sides of its faces. Its scanned bark
// is dark brown: painted, it is a lichened trunk's pale grey-brown.
/** How light passes through its leaves. */
const FOLIAGE = { translucency: 0.6 };
/** What its bark's colour is multiplied by. */
const BARK = new THREE.Color(1.7, 1.85, 2.1);
/** Levels share materials: each is painted once. */
const painted = new WeakSet<THREE.Material>();
const loader = new CachedLodLoader(loadingManager, {
  onLevel: (object) => {
    foliageModel(object, FOLIAGE);
    foliageLevels(object, FOLIAGE);
    paintBark(object);
    object.traverse((node) => {
      node.castShadow = node.receiveShadow = true;
      if (node instanceof THREE.Mesh) for (const material of [node.material].flat()) material.shadowSide = THREE.DoubleSide;
    });
  },
});
const levels = await loader.loadAsync({
  url: "./tree_small_02_LOD0.glb",
  levels: [
    { type: "simplify", ratio: 0.1, maxPixels: 900 },
    { type: "impostor", layout: "hemi", maxPixels: 640, resolution: 256, frames: 16, draw: { depth: "card", parallax: 1 } },
    { type: "impostor", layout: "hemi", maxPixels: 160, resolution: 128, frames: 8, draw: { depth: "card", parallax: 0 } },
    { type: "impostor", layout: "hemi", maxPixels: 20, resolution: 16, frames: 8, draw: { depth: "card", parallax: 0 } },
  ],
});
const lod = new Lod(levels, 1, { manager: loadingManager });
scene.add(lod);
onDispose(() => lod.dispose());

scene.defaultCamera = new THREE.PerspectiveCamera(30, 1, 1.21, 121.29);
scene.defaultCamera.position.set(6.82, 8.93, 10.2);
scene.defaultCamera.lookAt(0.149, 2.25, 0.764);

if (isPreview) {
  const sun = new THREE.DirectionalLight("white", 3);
  sun.position.set(4, 6, 3);
  scene.add(sun, sun.target, new THREE.HemisphereLight("#dbe6f5", "#5b5140", 1.5));
}

/** Multiplies its opaque materials' colour, the bark's (the leaves are cut out), by BARK. */
function paintBark(object: THREE.Object3D) {
  object.traverse((node) => {
    if (!(node instanceof THREE.Mesh) || node instanceof ImpostorMesh) return;
    for (const material of [node.material].flat()) {
      if (!(material instanceof THREE.MeshStandardMaterial) || material.alphaTest > 0 || painted.has(material)) continue;
      painted.add(material);
      material.color.multiply(BARK);
    }
  });
}
