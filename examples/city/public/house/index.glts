import { loadingManager, onDispose, scene } from "@drawcall/glts";
import { detailed, house } from "./model.ts";
import { HOUSE_VARIANTS } from "./params.ts";
import { dispose } from "../shared/dispose.ts";
import { Materials } from "../shared/materials.ts";

const query = new URL(import.meta.url).searchParams;
const variantText = query.get("variant") ?? "0";
const variant = Number(variantText);
if (!(/^\d+$/.test(variantText) && variant < HOUSE_VARIANTS))
  throw new Error(`house: variant must be a whole number below ${HOUSE_VARIANTS}, not ${variantText}`);
const building = detailed(await Materials.load(loadingManager), house(variant));
onDispose(() => dispose(building));
scene.add(building);
