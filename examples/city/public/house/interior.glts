// The house's rooms, which its baked level shows through the windows.
import { disposeRecursive, loadingManager, onDispose, scene } from "@drawcall/glts";
import { house } from "./model.ts";
import { houseInterior } from "./interior.ts";
import { HOUSE_VARIANTS } from "./params.ts";
import { Materials } from "./materials.ts";

const query = new URL(import.meta.url).searchParams;
const variantText = query.get("variant") ?? "0";
const variant = Number(variantText);
if (!(/^\d+$/.test(variantText) && variant < HOUSE_VARIANTS))
  throw new Error(`house: variant must be a whole number below ${HOUSE_VARIANTS}, not ${variantText}`);
const { params } = house(variant);
const materials = new Materials(loadingManager);
const rooms = houseInterior(materials, params);
onDispose(() => disposeRecursive(scene));
// Each room stands on its own under the scene, as the bake reads them.
scene.add(...rooms.children);
await materials.ready();
