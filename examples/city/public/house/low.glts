// The house's closed low shell, which its baked level's windows and walls are baked onto.
import { disposeRecursive, onDispose, scene } from "@drawcall/glts";
import { house } from "./model.ts";
import { variantOf } from "./params.ts";

const variant = variantOf(import.meta.url);
const { params, low } = house(variant);
const shell = low(params);
onDispose(() => disposeRecursive(scene));
scene.add(shell);
