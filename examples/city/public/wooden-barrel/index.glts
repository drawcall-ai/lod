import { isPreview, loadingManager, onDispose, scene } from "@drawcall/glts";
import { CachedLodLoader, Lod, type LodLevel } from "@drawcall/lod";
import * as THREE from "three/webgpu";

// Poly Haven's wooden barrels, ?variant=barrel01 or barrel02, at levels of detail: its meshes nearby, a 128 px
// hemispherical impostor from 120 px, gone below 2 px. Every level casts and receives shadows, both sides of its
// faces.
const loader = new CachedLodLoader(loadingManager, {
  onLevel: (object) => {
    object.traverse((node) => {
      node.castShadow = node.receiveShadow = true;
      if (node instanceof THREE.Mesh) for (const material of [node.material].flat()) material.shadowSide = THREE.DoubleSide;
    });
  },
});
const LADDERS: Record<string, () => Promise<LodLevel[]>> = {
  barrel01: () =>
    loader.loadAsync({
      url: "./wooden_barrels_01_barrel01.glb",
      levels: [
        { type: "impostor", layout: "hemi", maxPixels: 120, resolution: 128, frames: 8 },
        { type: "empty", maxPixels: 2 },
      ],
    }),
  barrel02: () =>
    loader.loadAsync({
      url: "./wooden_barrels_01_barrel02.glb",
      levels: [
        { type: "impostor", layout: "hemi", maxPixels: 120, resolution: 128, frames: 8 },
        { type: "empty", maxPixels: 2 },
      ],
    }),
};
const variant = new URL(import.meta.url).searchParams.get("variant") ?? "barrel01";
const load = LADDERS[variant];
if (!load) throw new Error(`wooden_barrels_01: variant must be barrel01 or barrel02, not ${variant}`);
const lod = new Lod(await load(), 1, { manager: loadingManager });
scene.add(lod);
onDispose(() => lod.dispose());

scene.defaultCamera = new THREE.PerspectiveCamera(30, 1, 0.245, 24.49);
scene.defaultCamera.position.set(1.35, 1.81, 1.9);
scene.defaultCamera.lookAt(0, 0.458, 0);

if (isPreview) {
  const sun = new THREE.DirectionalLight("white", 3);
  sun.position.set(4, 6, 3);
  scene.add(sun, sun.target, new THREE.HemisphereLight("#dbe6f5", "#5b5140", 1.5));
}
