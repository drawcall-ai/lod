import { loadingManager, onDispose, scene } from "@drawcall/glts";
import * as THREE from "three/webgpu";
import { HERO_VARIANT, VARIANTS } from "../corn/layout.ts";
import { plant } from "../corn/model.ts";
import { leafSeat } from "../corn/seat.ts";
import { dispose } from "../shared/dispose.ts";
import { ladybird } from "./model.ts";
import { Materials } from "../shared/materials.ts";
import { number } from "../shared/parameters.ts";

// A ladybird on the hero plant's leaf, placed where that leaf stands in the plant's space.
const variant = number(new URL(import.meta.url).searchParams, "variant", HERO_VARIANT, 0, VARIANTS - 1, true);
const materials = await Materials.load(loadingManager);
const hero = plant(materials, variant, true);
const seat = leafSeat(hero);
dispose(hero);
const holder = new THREE.Group();
holder.position.copy(seat.point);
holder.quaternion.setFromUnitVectors(new THREE.Vector3(0, 1, 0), seat.normal);
const bug = ladybird(materials);
bug.rotation.y = seat.heading;
holder.add(bug);
onDispose(() => dispose(holder));
scene.add(holder);
