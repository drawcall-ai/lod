import { disposeRecursive, onDispose, scene } from "@drawcall/glts";
import * as THREE from "three/webgpu";
import { mergeGeometries, mergeVertices } from "three/addons/utils/BufferGeometryUtils.js";

/** Merges geometries that share attributes; non-indexed inputs get an index first. */
function merge(list: THREE.BufferGeometry[]): THREE.BufferGeometry {
  const parts = list.map((g) => (g.index ? strip(g) : mergeVertices(strip(g))));
  const merged = mergeGeometries(parts);
  if (!merged) throw new Error("mergeGeometries failed: inputs have different attributes");
  return merged;
}

/** Keeps only the attributes all generators share, so any two parts can merge. */
function strip(g: THREE.BufferGeometry): THREE.BufferGeometry {
  for (const name of Object.keys(g.attributes)) if (!["position", "normal", "uv", "color"].includes(name)) g.deleteAttribute(name);
  g.morphAttributes = {};
  g.clearGroups();
  return g;
}

/** Adds a constant vertex colour so the geometry can merge with vertex-coloured parts. */
function tint(g: THREE.BufferGeometry, color: THREE.Color): THREE.BufferGeometry {
  const n = g.getAttribute("position").count;
  const data = new Float32Array(n * 3);
  for (let i = 0; i < n; i++) color.toArray(data, i * 3);
  g.setAttribute("color", new THREE.BufferAttribute(data, 3));
  return g;
}

/**
 * Collects geometry per material and builds one shadowed mesh per material. `at(matrix)`
 * returns a view that places everything added through it in a local frame.
 */
class Parts {
  constructor(
    private readonly byMaterial = new Map<THREE.Material, THREE.BufferGeometry[]>(),
    private readonly matrix?: THREE.Matrix4,
  ) {}

  at(matrix: THREE.Matrix4): Parts {
    return new Parts(this.byMaterial, this.matrix ? this.matrix.clone().multiply(matrix) : matrix);
  }

  add(material: THREE.Material, ...geometries: THREE.BufferGeometry[]): void {
    const list = this.byMaterial.get(material) ?? [];
    for (const g of geometries) list.push(this.matrix ? g.applyMatrix4(this.matrix) : g);
    this.byMaterial.set(material, list);
  }

  build(name: string): THREE.Group {
    const group = new THREE.Group();
    group.name = name;
    for (const [material, list] of this.byMaterial) {
      const mesh = new THREE.Mesh(merge(list), material);
      mesh.name = `${name}:${material.name}`;
      mesh.castShadow = mesh.receiveShadow = true;
      group.add(mesh);
    }
    return group;
  }
}

/** Appends vertices and triangles by hand for surfaces no three.js geometry produces. */
class MeshBuilder {
  private readonly position: number[] = [];
  private readonly uv: number[] = [];
  private readonly color: number[] = [];
  private readonly index: number[] = [];

  get count(): number {
    return this.position.length / 3;
  }

  vertex(p: THREE.Vector3, u: number, v: number, c: THREE.Color): number {
    this.position.push(p.x, p.y, p.z);
    this.uv.push(u, v);
    this.color.push(c.r, c.g, c.b);
    return this.count - 1;
  }

  /** Two triangles over a, b, c, d in counter-clockwise order seen from the front. */
  quad(a: number, b: number, c: number, d: number): void {
    this.index.push(a, b, c, a, c, d);
  }

  triangle(a: number, b: number, c: number): void {
    this.index.push(a, b, c);
  }

  /**
   * Quads over a grid of vertices added row by row from index `first`: `rows` + 1 rows of `columns` + 1 vertices, each
   * quad wound counter-clockwise seen from the front, or the other way if `reversed`.
   */
  grid(first: number, rows: number, columns: number, reversed = false): void {
    const at = (row: number, column: number) => first + row * (columns + 1) + column;
    for (let i = 0; i < rows; i++)
      for (let j = 0; j < columns; j++) {
        const [a, b, c, d] = [at(i, j), at(i, j + 1), at(i + 1, j + 1), at(i + 1, j)];
        if (reversed) this.quad(a, d, c, b);
        else this.quad(a, b, c, d);
      }
  }

  /** Vertex normals are averaged only over shared vertices, so separate pieces stay separate. */
  geometry(): THREE.BufferGeometry {
    const g = new THREE.BufferGeometry();
    g.setAttribute("position", new THREE.Float32BufferAttribute(this.position, 3));
    g.setAttribute("uv", new THREE.Float32BufferAttribute(this.uv, 2));
    g.setAttribute("color", new THREE.Float32BufferAttribute(this.color, 3));
    g.setIndex(this.index);
    g.computeVertexNormals();
    return g;
  }
}

/**
 * A closed-ended tube along a curve whose radius varies with t ∈ [0, 1] (stalks, stems,
 * legs). UVs: u around, v along in metres; colour per t allows gradients.
 */
function tube(
  curve: THREE.Curve<THREE.Vector3>,
  radius: (t: number) => number,
  segments: number,
  radial: number,
  color: (t: number) => THREE.Color,
  /** Cross-section height over width, for flattened tubes such as insect legs. */
  aspect = 1,
): THREE.BufferGeometry {
  const b = new MeshBuilder();
  const frames = curve.computeFrenetFrames(segments, false);
  const length = curve.getLength();
  const p = new THREE.Vector3();
  for (let i = 0; i <= segments; i++) {
    const t = i / segments;
    const center = curve.getPointAt(t);
    const n = frames.normals[i];
    const bn = frames.binormals[i];
    if (!n || !bn) throw new Error("missing Frenet frame");
    const r = radius(t);
    const c = color(t);
    for (let j = 0; j <= radial; j++) {
      const a = (j / radial) * Math.PI * 2;
      p.copy(center)
        .addScaledVector(n, Math.cos(a) * r)
        .addScaledVector(bn, Math.sin(a) * r * aspect);
      b.vertex(p, j / radial, t * length, c);
    }
  }
  b.grid(0, segments, radial);
  // cap the far end so thin tubes do not show their hollow inside
  const end = curve.getPointAt(1);
  const last = segments * (radial + 1);
  const tip = b.vertex(end, 0.5, length, color(1));
  for (let j = 0; j < radial; j++) b.triangle(last + j, last + j + 1, tip);
  return b.geometry();
}

/** Black chitin: glossy but not mirror-like. */
const blackMaterial = () =>
  new THREE.MeshPhysicalMaterial({
    name: "ladybird-black",
    color: "#0d0d0c",
    vertexColors: true,
    roughness: 0.35,
    clearcoat: 0.7,
    clearcoatRoughness: 0.2,
  });

/** [x across from the suture, z forward, radius] in footprint units, as `spot` takes them. */
type Spot = [number, number, number];

/**
 * The elytra's spots: one shared across the suture at the front, then shoulder, middle (largest) and rear on each
 * side.
 */
const SPOTS: Spot[] = [
  [0, 0.8, 0.17],
  ...[-1, 1].flatMap((s): Spot[] => [
    [s * 0.58, 0.45, 0.14],
    [s * 0.46, -0.02, 0.21],
    [s * 0.36, -0.52, 0.15],
  ]),
];

/** Elytra: lacquer red with the spot pattern and a finely dimpled clear coat. */
const shellMaterial = () =>
  new THREE.MeshPhysicalMaterial({
    name: "ladybird-elytra",
    map: paint(1024, (x, z, texel) => {
      // a radial gradient from the shell's crown, just forward of its centre, to its rim
      const t = THREE.MathUtils.clamp((Math.hypot(x, z - 0.1) / 2 - 0.05) / 0.5, 0, 1);
      let color = t < 0.85 ? mix(hex("#d8341a"), hex("#c0240f"), t / 0.85) : mix(hex("#c0240f"), hex("#8e1a0c"), (t - 0.85) / 0.15);
      // a soft edge, about three texels wide: pigment, not a printed decal
      for (const [sx, sz, r] of SPOTS) color = mix(color, hex("#14100e"), spot(x, z, sx, sz, r, 3 * texel));
      // the suture between the elytra, from the rear to just behind the front spot
      const suture = z < 0.84 ? THREE.MathUtils.clamp((0.005 - Math.abs(x)) / texel + 0.5, 0, 1) : 0;
      return mix(color, [40, 6, 2], 0.85 * suture);
    }),
    // the punctation lies under the lacquer-like coat: it only breaks up the highlight, and
    // spots and red share the one coat, so they reflect identically
    clearcoatNormalMap: dimples(2048, 9000, 2.2, 0.0012),
    clearcoatNormalScale: new THREE.Vector2(0.35, 0.35),
    roughness: 0.55,
    clearcoat: 1,
    clearcoatRoughness: 0.15,
  });

/** Pronotum: black with the cream patches in its front corners. */
const pronotumMaterial = () =>
  new THREE.MeshPhysicalMaterial({
    name: "ladybird-pronotum",
    map: paint(512, (x, z, texel) => mix(hex("#0d0d0c"), hex("#ede5cf"), Math.max(spot(x, z, -0.7, 0.5, 0.2, texel), spot(x, z, 0.7, 0.5, 0.2, texel)))),
    roughness: 0.35,
    clearcoat: 1,
    clearcoatRoughness: 0.15,
  });

/** Head: black with two small pale spots between the eyes. */
const headMaterial = () =>
  new THREE.MeshPhysicalMaterial({
    name: "ladybird-head",
    map: paint(256, (x, z, texel) => mix(hex("#0d0d0c"), hex("#e3dcc6"), Math.max(spot(x, z, -0.42, 0.25, 0.15, texel), spot(x, z, 0.42, 0.25, 0.15, texel)))),
    roughness: 0.3,
    clearcoat: 0.8,
    clearcoatRoughness: 0.15,
  });

/** An sRGB colour, 0–255 a channel. */
type Rgb = [number, number, number];

function hex(color: string): Rgb {
  const channel = (at: number) => parseInt(color.slice(at, at + 2), 16);
  return [channel(1), channel(3), channel(5)];
}
const mix = (a: Rgb, b: Rgb, t: number): Rgb => [a[0] + (b[0] - a[0]) * t, a[1] + (b[1] - a[1]) * t, a[2] + (b[2] - a[2]) * t];

/**
 * A square sRGB texture whose u/v match the dome's footprint coordinates: `color` answers each texel's colour at its
 * footprint coordinates (x across, z forward, each in [-1, 1]), given the width of a texel in those units.
 */
function paint(size: number, color: (x: number, z: number, texel: number) => Rgb): THREE.DataTexture {
  const data = new Uint8Array(size * size * 4);
  for (let row = 0; row < size; row++) {
    for (let column = 0; column < size; column++) {
      const [r, g, b] = color(((column + 0.5) / size) * 2 - 1, ((row + 0.5) / size) * 2 - 1, 2 / size);
      data.set([Math.round(r), Math.round(g), Math.round(b), 255], (row * size + column) * 4);
    }
  }
  const t = new THREE.DataTexture(data, size, size, THREE.RGBAFormat, THREE.UnsignedByteType);
  t.colorSpace = THREE.SRGBColorSpace;
  t.generateMipmaps = true;
  t.minFilter = THREE.LinearMipmapLinearFilter;
  t.magFilter = THREE.LinearFilter;
  t.anisotropy = 8;
  t.needsUpdate = true;
  return t;
}

/**
 * How much of a slightly irregular round spot centred at footprint coordinates (sx, sz), of radius about `r` in the
 * same units, covers (x, z): 1 inside, fading to 0 across `edge` at its outline.
 */
function spot(x: number, z: number, sx: number, sz: number, r: number, edge: number): number {
  const dx = x - sx;
  const dz = z - sz;
  if (Math.abs(dx) > 1.1 * r + edge || Math.abs(dz) > 1.1 * r + edge) return 0;
  // angles as a canvas with v running down measured them, so the outline keeps its shape
  const a = Math.atan2(-dz, dx);
  const radius = r * (1 + 0.05 * Math.sin(a * 3 + sx * 7) + 0.03 * Math.sin(a * 5 + sz * 11));
  return THREE.MathUtils.clamp((radius - Math.hypot(dx, dz)) / edge + 0.5, 0, 1);
}

/** A normal map of shallow round punctures scattered over the surface, as on beetle cuticle. */
function dimples(size: number, count: number, radius: number, depth: number): THREE.DataTexture {
  const height = new Float32Array(size * size);
  let seed = 9;
  const rand = () => (seed = (Math.imul(seed, 1664525) + 1013904223) >>> 0) / 4294967296;
  for (let k = 0; k < count; k++) {
    const cx = rand() * size;
    const cy = rand() * size;
    const r = radius * (0.7 + 0.6 * rand());
    for (let y = Math.floor(cy - r); y <= cy + r; y++) {
      for (let x = Math.floor(cx - r); x <= cx + r; x++) {
        const d = Math.hypot(x - cx, y - cy) / r;
        if (d >= 1) continue;
        const i = ((y + size) % size) * size + ((x + size) % size);
        height[i] = (height[i] ?? 0) - depth * size * (1 - d * d) ** 2;
      }
    }
  }
  const data = new Uint8Array(size * size * 4);
  const n = new THREE.Vector3();
  const at = (x: number, y: number) => height[((y + size) % size) * size + ((x + size) % size)] ?? 0;
  for (let y = 0; y < size; y++) {
    for (let x = 0; x < size; x++) {
      n.set(-(at(x + 1, y) - at(x - 1, y)), -(at(x, y + 1) - at(x, y - 1)), 1).normalize();
      const i = (y * size + x) * 4;
      data[i] = Math.round((n.x * 0.5 + 0.5) * 255);
      data[i + 1] = Math.round((n.y * 0.5 + 0.5) * 255);
      data[i + 2] = Math.round((n.z * 0.5 + 0.5) * 255);
      data[i + 3] = 255;
    }
  }
  const t = new THREE.DataTexture(data, size, size, THREE.RGBAFormat, THREE.UnsignedByteType);
  t.wrapS = t.wrapT = THREE.RepeatWrapping;
  t.generateMipmaps = true;
  t.minFilter = THREE.LinearMipmapLinearFilter;
  t.magFilter = THREE.LinearFilter;
  t.needsUpdate = true;
  return t;
}

/** The model is laid out in millimetres and scaled to metres at the end. */
const mm = 0.001;
/** Height of the body's underside above the ground (mm). */
const clearance = 0.35;
const ink = new THREE.Color("#ffffff");

/**
 * A seven-spot ladybird (Coccinella septempunctata), 7 mm long, standing on y = 0 and facing
 * +z, in the proportions of macro photographs: slightly ovoid elytra (5.4 wide x 5.7 mm long,
 * 2.1 mm high) with a faint ridge along the suture and the spot pattern painted into the same
 * clear-coated surface; a thin, flattened pronotum shield with cream front corners that hides
 * most of the head; short antennae under the head; legs folded under the body so that at rest
 * mostly the tarsi show.
 */
function ladybird(): THREE.Group {
  const black = blackMaterial();
  const parts = new Parts();
  // elytra are centred 0.9 mm behind the origin; the pronotum abuts their front edge
  parts.add(shellMaterial(), dome({ hw: 2.7, hl: 2.85, height: 2.1, z: -0.9, y: clearance, taper: 0.08, exponent: 0.55, lip: 0.1, seam: 0.035 }));
  parts.add(
    black,
    tint(
      new THREE.CircleGeometry(1, 48)
        .scale(2.6, 2.75, 1)
        .rotateX(Math.PI / 2)
        .translate(0, clearance + 0.01, -0.9),
      ink,
    ),
  );
  // pronotum: its back emerges from the steep front of the elytra, its front edge hugs the head
  parts.add(pronotumMaterial(), dome({ hw: 1.7, hl: 0.75, height: 0.8, z: 1.95, y: clearance + 0.1, taper: 0.32, exponent: 0.6, lip: 0, seam: 0 }));
  // head: tucked under the pronotum's front edge, only its front showing
  parts.add(headMaterial(), dome({ hw: 0.6, hl: 0.38, height: 0.4, z: 2.62, y: clearance, taper: 0.2, exponent: 0.6, lip: 0, seam: 0 }));

  // antennae: short and clubbed, folded back under the head
  for (const s of [-1, 1]) {
    const base = new THREE.Vector3(s * 0.4, clearance + 0.08, 2.8);
    const curve = new THREE.QuadraticBezierCurve3(
      base,
      base.clone().add(new THREE.Vector3(s * 0.25, 0.02, 0.15)),
      base.clone().add(new THREE.Vector3(s * 0.55, -0.08, 0.05)),
    );
    parts.add(
      black,
      tube(
        curve,
        (t) => 0.03 + 0.05 * t ** 6,
        10,
        6,
        () => ink,
      ),
    );
  }
  // legs folded under the body: femur and tibia stay beneath the elytra, tarsi reach the rim
  for (const s of [-1, 1]) {
    for (const [i, z] of [1.3, 0.1, -1.2].entries()) {
      const forward = 1 - i;
      const hip = new THREE.Vector3(s * 0.7, clearance + 0.1, z);
      const knee = new THREE.Vector3(s * 1.75, clearance - 0.1, z + forward * 0.35);
      const ankle = new THREE.Vector3(s * 2.15, 0.08, z + forward * 0.7);
      const toe = new THREE.Vector3(s * 2.6, 0.03, z + forward * 1.0 + (forward === 0 ? 0.2 : 0));
      parts.add(
        black,
        tube(
          new THREE.LineCurve3(hip, knee),
          (t) => 0.17 - 0.04 * t,
          8,
          8,
          () => ink,
          0.6,
        ),
      );
      parts.add(
        black,
        tube(
          new THREE.LineCurve3(knee, ankle),
          (t) => 0.11 - 0.03 * t,
          8,
          8,
          () => ink,
          0.7,
        ),
      );
      // three tarsal segments, each swelling then pinching
      parts.add(
        black,
        tube(
          new THREE.LineCurve3(ankle, toe),
          (t) => 0.045 + 0.035 * Math.abs(Math.sin(t * Math.PI * 3)),
          18,
          6,
          () => ink,
          0.6,
        ),
      );
    }
  }
  const group = parts.build("ladybird");
  group.scale.setScalar(mm);
  return group;
}

interface DomeShape {
  /** Half width and half length of the footprint (mm). */
  hw: number;
  hl: number;
  height: number;
  /** Centre of the footprint along z, and height of its rim. */
  z: number;
  y: number;
  /** How much narrower the front (+z) is than the back. */
  taper: number;
  /** Profile exponent: 0.5 is elliptical, larger is flatter-topped with steeper sides. */
  exponent: number;
  /** Height of the flat rim at the edge, relative to `height` (0 for none). */
  lip: number;
  /** Height of the ridge along the midline (mm), where the elytra meet. */
  seam: number;
}

/**
 * Height of the dome at normalised radius rho: elliptical-ish, with the last few percent
 * flattened into a narrow lip (the explanate margin of the elytra) that ends in a short edge.
 */
function profile(rho: number, x: number, s: DomeShape): number {
  const dome = s.height * Math.max(0, 1 - rho * rho) ** s.exponent + s.seam * Math.exp(-((x / 0.07) ** 2)) * (1 - rho);
  const lip = s.height * s.lip * THREE.MathUtils.smoothstep(rho, 0.86, 0.97);
  return rho < 1 ? Math.max(dome, lip) : 0;
}

/** A dome over an egg-shaped footprint, with planar top-down UVs (u across, v from back to front). */
function dome(s: DomeShape): THREE.BufferGeometry {
  const b = new MeshBuilder();
  const rings = 48;
  const around = 96;
  const p = new THREE.Vector3();
  for (let i = 0; i <= rings; i++) {
    const rho = i / rings;
    for (let j = 0; j <= around; j++) {
      const a = (j / around) * Math.PI * 2;
      const fz = Math.sin(a);
      const x = rho * Math.cos(a) * s.hw * (1 - s.taper * Math.max(0, fz));
      const z = rho * fz * s.hl;
      p.set(x, s.y + profile(rho, x, s), s.z + z);
      b.vertex(p, 0.5 + x / (2 * s.hw), 0.5 + z / (2 * s.hl), ink);
    }
  }
  b.grid(0, rings, around);
  return b.geometry();
}

// A seven-spot ladybird standing on y = 0, facing +z.
const bug = ladybird();
onDispose(() => disposeRecursive(scene));
scene.add(bug);
