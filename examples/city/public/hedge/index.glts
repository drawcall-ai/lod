import { disposeRecursive, loadingManager, onDispose, scene } from "@drawcall/glts";
import { hedge } from "./model.ts";

const query = new URL(import.meta.url).searchParams;
const lengthText = query.get("length") ?? "2.4";
const length = Number(lengthText);
if (!(/^\d+(\.\d+)?$/.test(lengthText) && length >= 0.1 && length <= 100)) throw new Error(`hedge: length must be in [0.1, 100] m, not ${lengthText}`);
const variantText = query.get("variant") ?? "0";
const variant = Number(variantText);
if (!/^\d+$/.test(variantText)) throw new Error(`hedge: variant must be a whole number, not ${variantText}`);
// Seeds start at 1, which keeps the hedges the variants were first tuned with.
const object = hedge(loadingManager, length, variant + 1);
onDispose(() => disposeRecursive(scene));
scene.add(object);
