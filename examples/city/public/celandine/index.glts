import { isPreview, loadingManager, onDispose, scene } from "@drawcall/glts";
import { CachedLodLoader, foliageLevels, foliageModel, Lod, type LodLevel } from "@drawcall/lod";
import * as THREE from "three/webgpu";

// Poly Haven's lesser celandine, ?variant=a, b, c, d or e, at levels of detail: the scan, a 128 px hemispherical
// impostor, gone below 3 px. Its leaves are foliage. It receives shadows and casts none.
/** How light passes through its leaves. */
const FOLIAGE = { translucency: 0.6 };
const loader = new CachedLodLoader(loadingManager, {
  onLevel: (object) => {
    foliageModel(object, FOLIAGE);
    foliageLevels(object, FOLIAGE);
    object.traverse((node) => {
      node.castShadow = false;
      node.receiveShadow = true;
    });
  },
});
const LADDERS: Record<string, () => Promise<LodLevel[]>> = {
  a: () =>
    loader.loadAsync({
      url: "./celandine_01_a_LOD0.glb",
      levels: [
        { type: "impostor", layout: "hemi", resolution: 128, frames: 8 },
        { type: "empty", maxPixels: 3 },
      ],
    }),
  b: () =>
    loader.loadAsync({
      url: "./celandine_01_b_LOD0.glb",
      levels: [
        { type: "impostor", layout: "hemi", resolution: 128, frames: 8 },
        { type: "empty", maxPixels: 3 },
      ],
    }),
  c: () =>
    loader.loadAsync({
      url: "./celandine_01_c_LOD0.glb",
      levels: [
        { type: "impostor", layout: "hemi", resolution: 128, frames: 8 },
        { type: "empty", maxPixels: 3 },
      ],
    }),
  d: () =>
    loader.loadAsync({
      url: "./celandine_01_d_LOD0.glb",
      levels: [
        { type: "impostor", layout: "hemi", resolution: 128, frames: 8 },
        { type: "empty", maxPixels: 3 },
      ],
    }),
  e: () =>
    loader.loadAsync({
      url: "./celandine_01_e_LOD0.glb",
      levels: [
        { type: "impostor", layout: "hemi", resolution: 128, frames: 8 },
        { type: "empty", maxPixels: 3 },
      ],
    }),
};
const variant = new URL(import.meta.url).searchParams.get("variant") ?? "a";
const load = LADDERS[variant];
if (!load) throw new Error(`celandine_01: variant must be a, b, c, d or e, not ${variant}`);
const lod = new Lod(await load(), 1, { manager: loadingManager });
scene.add(lod);
onDispose(() => lod.dispose());

scene.defaultCamera = new THREE.PerspectiveCamera(30, 1, 0.071, 7.08);
scene.defaultCamera.position.set(0.39, 0.475, 0.551);
scene.defaultCamera.lookAt(0, 0.086, 0);

if (isPreview) {
  const sun = new THREE.DirectionalLight("white", 3);
  sun.position.set(4, 6, 3);
  scene.add(sun, sun.target, new THREE.HemisphereLight("#dbe6f5", "#5b5140", 1.5));
}
