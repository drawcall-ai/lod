import { disposeRecursive, gltsLoader, loadingManager, onDispose, scene } from "@drawcall/glts";
import { CachedLodLoader, Lod, type LodLevel } from "@drawcall/lod";
import * as THREE from "three/webgpu";
import { Fn, cameraPosition, distance, mix, modelWorldMatrix, positionLocal, smoothstep, vec3, vec4 } from "three/tsl";
import { BLOCK } from "../layout.ts";
import { canopy, SINK, TOP } from "./shapes.ts";
import { skirt } from "./skirt.ts";

// A block of corn field as a field draws it beyond its plants, ?design=0 to 3, baked from source.glts's plants onto
// low.glts's shell: after an empty level 0, where the field draws its plants, the canopy rising out of the soil (see
// skirt.ts), then ridged, then flat. With ?wall=x or ?wall=z, the field's outer wall along that side of a block of
// design 0, which only rises. Its thresholds keep it whole at any size; a field moves them with its plants'.
loadingManager.addHandler(/\.glts$/i, gltsLoader);
const loader = new CachedLodLoader(loadingManager);
const BAKES: Record<string, () => Promise<LodLevel[]>> = {
  "0": () => loader.loadAsync({ url: "./source.glts?design=0", levels: [{ type: "baked", low: "./low.glts", textureSize: 256 }] }),
  "1": () => loader.loadAsync({ url: "./source.glts?design=1", levels: [{ type: "baked", low: "./low.glts", textureSize: 256 }] }),
  "2": () => loader.loadAsync({ url: "./source.glts?design=2", levels: [{ type: "baked", low: "./low.glts", textureSize: 256 }] }),
  "3": () => loader.loadAsync({ url: "./source.glts?design=3", levels: [{ type: "baked", low: "./low.glts", textureSize: 256 }] }),
  x: () => loader.loadAsync({ url: "./source.glts?design=0&wall=x", levels: [{ type: "baked", low: "./low.glts?wall=x", textureSize: 256 }] }),
  z: () => loader.loadAsync({ url: "./source.glts?design=0&wall=z", levels: [{ type: "baked", low: "./low.glts?wall=z", textureSize: 256 }] }),
};
const query = new URL(import.meta.url).searchParams;
const wall = query.get("wall");
const design = query.get("design") ?? "0";
const load = BAKES[wall ?? design];
if (!load || (wall !== null && query.has("design"))) throw new Error(`corn block: give ?design=0 to 3, or ?wall=x or z, not ${query}`);
const [, baked] = await load();
const bake = baked?.object ?? (await baked?.load?.());
if (!(bake instanceof THREE.Mesh) || !(bake.material instanceof THREE.MeshStandardNodeMaterial))
  throw new Error("corn block: its baked level is not a mesh of a standard material");
const material = bake.material;
for (const map of [material.map, material.normalMap]) if (map) map.anisotropy = 8;
material.normalScale.set(0.6, 0.6);
material.roughnessMap = null;
material.roughness = 0.9;
const rises = skirt();
const levels = wall === null ? canopyLevels(bake.geometry) : [wallLevel(bake.geometry)];
const lod = new Lod([{ object: new THREE.Object3D() }, ...levels], 1, { manager: loadingManager });
// drawn before the plants, which then skip the pixels it hides
lod.traverse((node) => (node.renderOrder = -1));
scene.add(lod);
onDispose(() => {
  lod.dispose();
  disposeRecursive(new THREE.Group().add(bake, ...levels.map(({ object }) => object)));
});

/** The canopy rising out of the soil near the camera, then the bake on its ridges, then flat far away, where the ridges are subpixel. */
function canopyLevels(geometry: THREE.BufferGeometry): { object: THREE.Mesh; maxPixels: number }[] {
  const near = new THREE.Mesh(canopy(BLOCK * 2), rising(material));
  const ridged = new THREE.Mesh(geometry, material);
  const flat = new THREE.Mesh(new THREE.PlaneGeometry(BLOCK, BLOCK).rotateX(-Math.PI / 2).translate(0, TOP, 0), material);
  const levels = [
    { object: near, maxPixels: Infinity },
    { object: ridged, maxPixels: 1000 },
    { object: flat, maxPixels: 60 },
  ];
  for (const { object } of levels) {
    object.castShadow = false;
    object.receiveShadow = true;
  }
  return levels;
}

/** The wall, which reaches into the soil up close: its bake's shell ends at the ground, inside the plants' bounds. */
function wallLevel(geometry: THREE.BufferGeometry): { object: THREE.Mesh; maxPixels: number } {
  const sunk = geometry.clone();
  const position = sunk.getAttribute("position");
  for (let i = 0; i < position.count; i++) if (position.getY(i) === 0) position.setY(i, -SINK);
  const object = new THREE.Mesh(sunk, rising(material));
  object.castShadow = object.receiveShadow = true;
  return { object, maxPixels: Infinity };
}

/**
 * A copy of `material` that rises out of the soil with distance from the camera: sunk below the ground nearer than
 * `rises.x`, whole from `rises.y` on. Between, the plants hide it; the ramp it forms closes the canopy, so that past
 * the plants no view reaches under it.
 */
function rising(material: THREE.MeshStandardNodeMaterial): THREE.MeshStandardNodeMaterial {
  const copy = material.clone();
  // after the instance matrix: the vertex in the block's space, placed in the field
  copy.positionNode = Fn(() => {
    const world = modelWorldMatrix.mul(vec4(positionLocal, 1)).xyz;
    const up = smoothstep(rises.x, rises.y, distance(world, cameraPosition));
    return vec3(positionLocal.x, mix(-SINK, positionLocal.y, up), positionLocal.z);
  })();
  return copy;
}
