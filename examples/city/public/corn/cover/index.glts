import { disposeRecursive, onDispose, scene } from "@drawcall/glts";
import { patch } from "./model.ts";
import { DESIGNS } from "../layout.ts";
import { cornMaterials } from "../tissue.ts";

// The plants a corn cover is baked from (see cover-low.glts).
const query = new URL(import.meta.url).searchParams;
const designText = query.get("design") ?? "0";
const design = Number(designText);
if (!(/^\d+$/.test(designText) && design < DESIGNS)) throw new Error(`corn cover: design must be a whole number below ${DESIGNS}, not ${designText}`);
const axis = query.get("axis") ?? "";
if (axis !== "" && axis !== "x" && axis !== "z") throw new Error(`corn cover: axis must be x or z, not ${axis}`);
const plants = patch(cornMaterials(), design, axis);
onDispose(() => disposeRecursive(scene));
scene.add(plants);
