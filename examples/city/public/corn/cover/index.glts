import { loadingManager, onDispose, scene } from "@drawcall/glts";
import * as THREE from "three/webgpu";
import { patch } from "./model.ts";
import { DESIGNS } from "../layout.ts";
import { dispose } from "../../shared/dispose.ts";
import { Materials } from "../../shared/materials.ts";
import { choice, number } from "../../shared/parameters.ts";

// The plants a corn cover is baked from (see cover-low.glts).
const query = new URL(import.meta.url).searchParams;
const design = number(query, "design", 0, 0, DESIGNS - 1, true);
const plants = patch(await Materials.load(loadingManager), design, choice(query, "axis", ["x", "z"], ""));
onDispose(() => {
  plants.traverse((object) => {
    if (object instanceof THREE.InstancedMesh) object.dispose();
  });
  dispose(plants);
});
scene.add(plants);
