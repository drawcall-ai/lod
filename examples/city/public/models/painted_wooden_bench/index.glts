import { isPreview, loadingManager, onDispose, scene } from "@drawcall/glts";
import { CachedLodLoader, Lod } from "@drawcall/lod";
import * as THREE from "three/webgpu";

// Poly Haven's painted wooden bench (scripts/fetch-assets.ts fetches it) at levels of detail: its meshes nearby,
// simplified, then a small impostor, whose self-contained textures defer the model's own, gone below 3 px. Every level
// casts and receives shadows, both sides of its faces.
const loader = new CachedLodLoader(loadingManager, {
  onLevel: (object) => {
    object.traverse((node) => {
      node.castShadow = node.receiveShadow = true;
      if (node instanceof THREE.Mesh) for (const material of [node.material].flat()) material.shadowSide = THREE.DoubleSide;
    });
  },
});
const levels = await loader.loadAsync({
  url: "./painted_wooden_bench.glb",
  levels: [
    { type: "simplify", ratio: 0.5 },
    { type: "impostor", layout: "hemi", frames: 8, resolution: 64, maxPixels: 60 },
    { type: "empty", maxPixels: 3 },
  ],
});
const lod = new Lod(levels, 1, { manager: loadingManager });
scene.add(lod);
onDispose(() => lod.dispose());

scene.defaultCamera = new THREE.PerspectiveCamera(30, 1, 0.3, 30);
scene.defaultCamera.position.set(1.61, 1.47, 2.31);
scene.defaultCamera.lookAt(0, 0.44, 0);

if (isPreview) {
  const sun = new THREE.DirectionalLight("white", 3);
  sun.position.set(4, 6, 3);
  scene.add(sun, sun.target, new THREE.HemisphereLight("#dbe6f5", "#5b5140", 1.5));
}
