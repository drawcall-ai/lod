import { loadingManager, onDispose, scene } from "@drawcall/glts";
import { CachedLodLoader, foliageLevels, foliageModel, Lod } from "@drawcall/lod";
import * as THREE from "three/webgpu";

// Poly Haven's small broadleaf tree (scripts/fetch-assets.ts fetches it) at levels of detail: the scan with its full
// leaf geometry nearby, a large hemispherical impostor, then a 64 px one from 60 px. Its leaves are foliage; every
// level casts and receives shadows, both sides of its faces.
/** How light passes through its leaves. */
const FOLIAGE = { translucency: 0.6 };
const loader = new CachedLodLoader(loadingManager, {
  onLevel: (object) => {
    foliageModel(object, FOLIAGE);
    foliageLevels(object, FOLIAGE);
    object.traverse((node) => {
      node.castShadow = node.receiveShadow = true;
      if (node instanceof THREE.Mesh) for (const material of [node.material].flat()) material.shadowSide = THREE.DoubleSide;
    });
  },
});
const levels = await loader.loadAsync({
  url: "../../assets/models/tree_small_02/tree_small_02_LOD0.glb",
  levels: [
    { type: "impostor", layout: "hemi", maxPixels: 900, resolution: 256, frames: 10 },
    { type: "impostor", layout: "hemi", maxPixels: 60, resolution: 64, frames: 8 },
  ],
});
const lod = new Lod(levels, 1, { manager: loadingManager });
scene.add(lod);
onDispose(() => lod.dispose());
