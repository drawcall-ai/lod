import { isPreview, loadingManager, onDispose, scene } from "@drawcall/glts";
import { CachedLodLoader, foliageLevels, foliageModel, Lod, type LodLevel } from "@drawcall/lod";
import * as THREE from "three/webgpu";

// Poly Haven's shrub (scripts/fetch-assets.ts fetches it), ?variant=a or c, at levels of detail: the scan, a detailed
// hemispherical impostor, a 64 px one from 60 px, a 16 px one from 20 px, gone below 2 px. Its leaves are foliage;
// every level casts and receives shadows, both sides of its faces.
/** How light passes through its leaves. */
const FOLIAGE = { translucency: 0.6 };
const loader = new CachedLodLoader(loadingManager, {
  onLevel: (object) => {
    foliageModel(object, FOLIAGE);
    foliageLevels(object, FOLIAGE);
    object.traverse((node) => {
      node.castShadow = node.receiveShadow = true;
      if (node instanceof THREE.Mesh) for (const material of [node.material].flat()) material.shadowSide = THREE.DoubleSide;
    });
  },
});
const LADDERS: Record<string, () => Promise<LodLevel[]>> = {
  a: () =>
    loader.loadAsync({
      url: "./shrub_02_a.glb",
      levels: [
        { type: "impostor", layout: "hemi", maxPixels: 300 },
        { type: "impostor", layout: "hemi", maxPixels: 60, resolution: 64, frames: 8 },
        { type: "impostor", layout: "hemi", maxPixels: 20, resolution: 16, frames: 8 },
        { type: "empty", maxPixels: 2 },
      ],
    }),
  c: () =>
    loader.loadAsync({
      url: "./shrub_02_c.glb",
      levels: [
        { type: "impostor", layout: "hemi", maxPixels: 300 },
        { type: "impostor", layout: "hemi", maxPixels: 60, resolution: 64, frames: 8 },
        { type: "impostor", layout: "hemi", maxPixels: 20, resolution: 16, frames: 8 },
        { type: "empty", maxPixels: 2 },
      ],
    }),
};
const variant = new URL(import.meta.url).searchParams.get("variant") ?? "a";
const load = LADDERS[variant];
if (!load) throw new Error(`shrub_02: variant must be a or c, not ${variant}`);
const lod = new Lod(await load(), 1, { manager: loadingManager });
scene.add(lod);
onDispose(() => lod.dispose());

scene.defaultCamera = new THREE.PerspectiveCamera(30, 1, 0.54, 54);
scene.defaultCamera.position.set(2.87, 2.72, 4.19);
scene.defaultCamera.lookAt(-0.05, 0.86, 0.02);

if (isPreview) {
  const sun = new THREE.DirectionalLight("white", 3);
  sun.position.set(4, 6, 3);
  scene.add(sun, sun.target, new THREE.HemisphereLight("#dbe6f5", "#5b5140", 1.5));
}
