import { isPreview, loadingManager, onDispose, scene } from "@drawcall/glts";
import { CachedLodLoader, foliageLevels, foliageModel, Lod, type LodLevel } from "@drawcall/lod";
import * as THREE from "three/webgpu";

// Poly Haven's medium fir sapling, ?variant=a, b or c, at levels of detail: the scan with its full leaf geometry
// nearby, simplified to 10 % of its leaf cards to 900 px, a 256 px hemispherical impostor, then a 64 px one. Its
// leaves are foliage. Every level casts and receives shadows, both sides of its faces.
/** How light passes through its leaves. */
const FOLIAGE = { translucency: 0.6 };
const loader = new CachedLodLoader(loadingManager, {
  onLevel: (object) => {
    foliageModel(object, FOLIAGE);
    foliageLevels(object, FOLIAGE);
    object.traverse((node) => {
      node.castShadow = node.receiveShadow = true;
      if (node instanceof THREE.Mesh) for (const material of [node.material].flat()) material.shadowSide = THREE.DoubleSide;
    });
  },
});
const LADDERS: Record<string, () => Promise<LodLevel[]>> = {
  a: () =>
    loader.loadAsync({
      url: "./fir_sapling_medium_a_LOD0.glb",
      levels: [
        { type: "simplify", ratio: 0.1, maxPixels: 900 },
        { type: "impostor", layout: "hemi", resolution: 256, frames: 10 },
        { type: "impostor", layout: "hemi", resolution: 64, frames: 8 },
      ],
    }),
  b: () =>
    loader.loadAsync({
      url: "./fir_sapling_medium_b_LOD0.glb",
      levels: [
        { type: "simplify", ratio: 0.1, maxPixels: 900 },
        { type: "impostor", layout: "hemi", resolution: 256, frames: 10 },
        { type: "impostor", layout: "hemi", resolution: 64, frames: 8 },
      ],
    }),
  c: () =>
    loader.loadAsync({
      url: "./fir_sapling_medium_c_LOD0.glb",
      levels: [
        { type: "simplify", ratio: 0.1, maxPixels: 900 },
        { type: "impostor", layout: "hemi", resolution: 256, frames: 10 },
        { type: "impostor", layout: "hemi", resolution: 64, frames: 8 },
      ],
    }),
};
const variant = new URL(import.meta.url).searchParams.get("variant") ?? "a";
const load = LADDERS[variant];
if (!load) throw new Error(`fir_sapling_medium: variant must be a, b or c, not ${variant}`);
const lod = new Lod(await load(), 1, { manager: loadingManager });
scene.add(lod);
onDispose(() => lod.dispose());

scene.defaultCamera = new THREE.PerspectiveCamera(30, 1, 2.01, 200.72);
scene.defaultCamera.position.set(10.98, 15.36, 15.69);
scene.defaultCamera.lookAt(-0.058, 4.32, 0.082);

if (isPreview) {
  const sun = new THREE.DirectionalLight("white", 3);
  sun.position.set(4, 6, 3);
  scene.add(sun, sun.target, new THREE.HemisphereLight("#dbe6f5", "#5b5140", 1.5));
}
