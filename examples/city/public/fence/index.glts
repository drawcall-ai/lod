import { disposeRecursive, loadingManager, onDispose, scene } from "@drawcall/glts";
import { picketFence } from "./model.ts";

const query = new URL(import.meta.url).searchParams;
const lengthText = query.get("length") ?? "2.4";
const length = Number(lengthText);
if (!(/^\d+(\.\d+)?$/.test(lengthText) && length >= 0.1 && length <= 100)) throw new Error(`fence: length must be in [0.1, 100] m, not ${lengthText}`);
const fence = picketFence(loadingManager, length);
onDispose(() => disposeRecursive(scene));
scene.add(fence);
