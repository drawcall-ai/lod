import { isPreview, loadingManager, onDispose, scene } from "@drawcall/glts";
import { CachedLodLoader, Lod } from "@drawcall/lod";
import * as THREE from "three/webgpu";

// Poly Haven's boulder at levels of detail: its meshes nearby, simplified to 15 %, a 64 px hemispherical impostor,
// gone below 2 px. It receives shadows, and casts them unless ?shadow=0.
const shadow = new URL(import.meta.url).searchParams.get("shadow") ?? "1";
if (shadow !== "0" && shadow !== "1") throw new Error(`boulder_01: shadow must be 0 or 1, not ${shadow}`);
const loader = new CachedLodLoader(loadingManager, {
  onLevel: (object) => {
    object.traverse((node) => {
      node.castShadow = shadow === "1";
      node.receiveShadow = true;
      if (node.castShadow && node instanceof THREE.Mesh) for (const material of [node.material].flat()) material.shadowSide = THREE.DoubleSide;
    });
  },
});
const levels = await loader.loadAsync({
  url: "./boulder_01.glb",
  levels: [
    { type: "simplify", ratio: 0.15, maxPixels: 227 },
    { type: "impostor", layout: "hemi", resolution: 64, frames: 8 },
    { type: "empty", maxPixels: 2 },
  ],
});
const lod = new Lod(levels, 1, { manager: loadingManager });
scene.add(lod);
onDispose(() => lod.dispose());

scene.defaultCamera = new THREE.PerspectiveCamera(30, 1, 0.429, 42.93);
scene.defaultCamera.position.set(2.36, 2.79, 3.34);
scene.defaultCamera.lookAt(0, 0.428, 0);

if (isPreview) {
  const sun = new THREE.DirectionalLight("white", 3);
  sun.position.set(4, 6, 3);
  scene.add(sun, sun.target, new THREE.HemisphereLight("#dbe6f5", "#5b5140", 1.5));
}
