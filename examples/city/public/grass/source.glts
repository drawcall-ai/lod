import * as THREE from "three/webgpu";
import { disposeRecursive, onDispose, scene } from "@drawcall/glts";
import { attribute, dot, fract, materialColor, mix, sin, smoothstep, step, vec2, vec3, vec4 } from "three/tsl";
import { Foliage, foliage } from "@drawcall/lod";
import seedrandom from "seedrandom";

interface ClumpShape {
  /** Edge of the square patch the blades grow in (m). */
  size: number;
  blades: number;
  /** Blade height range (m). */
  height: [number, number];
  /** Blade width at the base (m). */
  width: number;
}

/**
 * A square patch of grass blades, the patch centred on the origin on y = 0: each blade a
 * tapering strip of four segments that leans and bends over to a random side. `blade`
 * holds each vertex's blade root (x, z in the patch) and how far up the blade it is (0–1),
 * for `grassMaterial`.
 */
function grassClump(seed: number, s: ClumpShape): THREE.BufferGeometry {
  const r = seedrandom(String(seed));
  const position: number[] = [];
  const normal: number[] = [];
  const blade: number[] = [];
  const index: number[] = [];
  const segments = 4;
  for (let b = 0; b < s.blades; b++) {
    const x = (2 * r() - 1) * (s.size / 2);
    const z = (2 * r() - 1) * (s.size / 2);
    const height = s.height[0] + (s.height[1] - s.height[0]) * r();
    const facing = Math.PI * 2 * r();
    const lean = 0.05 + 0.45 * r();
    const bend = 0.3 + 0.9 * r();
    const lateral = new THREE.Vector3(Math.cos(facing), 0, Math.sin(facing));
    const forward = new THREE.Vector3(-lateral.z, 0, lateral.x);
    const width = s.width * (0.7 + 0.6 * r());
    const first = position.length / 3;
    const p = new THREE.Vector3(x, 0, z);
    for (let k = 0; k <= segments; k++) {
      const t = k / segments;
      const half = (width / 2) * (1 - t) ** 0.8;
      // up the blade, curving over toward `forward`
      const angle = lean + bend * t * t;
      const along = new THREE.Vector3(0, Math.cos(angle), 0).addScaledVector(forward, Math.sin(angle));
      const n = new THREE.Vector3().crossVectors(lateral, along).normalize();
      // lit mostly as the ground below is: blades pointing at the sky read as a meadow, not as glints
      n.lerp(new THREE.Vector3(0, 1, 0), 0.6).normalize();
      for (const side of [-1, 1]) {
        position.push(p.x + lateral.x * side * half, p.y, p.z + lateral.z * side * half);
        normal.push(n.x, n.y, n.z);
        blade.push(x, z, t);
      }
      p.addScaledVector(along, height / segments);
    }
    for (let k = 0; k < segments; k++) {
      const a = first + k * 2;
      index.push(a, a + 1, a + 2, a + 1, a + 3, a + 2);
    }
  }
  const g = new THREE.BufferGeometry();
  g.setAttribute("position", new THREE.Float32BufferAttribute(position, 3));
  g.setAttribute("normal", new THREE.Float32BufferAttribute(normal, 3));
  g.setAttribute("blade", new THREE.Float32BufferAttribute(blade, 3));
  g.setIndex(index);
  return g;
}

/**
 * Neutral blade shading: darker at the base, lighter and drier at the tips, each
 * blade a touch different. Ground colour is applied to the displayed levels.
 */
function grassMaterial(): Foliage {
  const m = foliage(new Foliage({ name: "grass", roughness: 0.75, side: THREE.DoubleSide }), { translucency: 0.5 });
  const blade = attribute<"vec3">("blade", "vec3");
  const along = blade.z;
  const seed = fract(sin(dot(blade.xy, vec2(127.1, 311.7))).mul(43758.5453));
  const base = vec3(1);
  const lift = mix(0.5, 1.25, smoothstep(0, 1, along));
  // one blade in six is dry: straw at the tip
  const dry = step(0.83, seed).mul(smoothstep(0.3, 1, along));
  const tip = mix(base, base.mul(vec3(1.15, 1.08, 0.8)), smoothstep(0.6, 1, along).mul(seed));
  const straw = mix(tip, vec3(dot(base, vec3(0.3, 0.59, 0.11))).mul(vec3(1.6, 1.35, 0.8)), dry.mul(0.7));
  // the material has no map: its colour is a vec3
  m.colorNode = vec4(materialColor.mul(straw.mul(lift).mul(fract(seed.mul(7.13)).mul(0.4).add(0.8))), 1);
  return m;
}

const query = new URL(import.meta.url).searchParams;
const kind = query.get("kind") ?? "lawn";
if (kind !== "lawn" && kind !== "meadow") throw new Error(`grass: kind must be lawn or meadow, not ${kind}`);
const shape: ClumpShape =
  kind === "meadow" ? { size: 0.5, blades: 125, height: [0.12, 0.45], width: 0.01 } : { size: 0.5, blades: 170, height: [0.05, 0.11], width: 0.008 };
const variantText = query.get("variant") ?? "0";
const variant = Number(variantText);
if (!/^\d+$/.test(variantText)) throw new Error(`grass: variant must be a whole number, not ${variantText}`);
// Seeds start at 1, which keeps the clumps the variants were first tuned with.
const geometry = grassClump(variant + 1, shape);
const material = grassMaterial();
const object = new THREE.Mesh(geometry, material);
object.receiveShadow = true;
onDispose(() => disposeRecursive(scene));
scene.add(object);
