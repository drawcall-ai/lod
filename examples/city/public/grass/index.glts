import * as THREE from "three/webgpu";
import { disposeRecursive, onDispose, scene } from "@drawcall/glts";
import { grassClump, grassMaterial, type ClumpShape } from "./model.ts";

const query = new URL(import.meta.url).searchParams;
const kind = query.get("kind") ?? "lawn";
if (kind !== "lawn" && kind !== "meadow") throw new Error(`grass: kind must be lawn or meadow, not ${kind}`);
const shape: ClumpShape =
  kind === "meadow" ? { size: 0.5, blades: 125, height: [0.12, 0.45], width: 0.01 } : { size: 0.5, blades: 170, height: [0.05, 0.11], width: 0.008 };
const variantText = query.get("variant") ?? "0";
const variant = Number(variantText);
if (!/^\d+$/.test(variantText)) throw new Error(`grass: variant must be a whole number, not ${variantText}`);
// Seeds start at 1, which keeps the clumps the variants were first tuned with.
const geometry = grassClump(variant + 1, shape);
const material = grassMaterial();
const object = new THREE.Mesh(geometry, material);
object.receiveShadow = true;
onDispose(() => disposeRecursive(scene));
scene.add(object);
