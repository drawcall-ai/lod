import { gltsLoader, loadingManager, onDispose, scene } from "@drawcall/glts";
import { CachedLodLoader, foliageLevels, ImpostorMesh, Lod, type LodLevel } from "@drawcall/lod";
import * as THREE from "three/webgpu";
import { vec4 } from "three/tsl";
import { groundColor } from "./ground.ts";

// A patch of grass, ?kind=lawn or meadow and ?variant=0 or 1, at levels of detail: source.glts's blades, then an
// impostor, gone below 1 px. Every level takes its colour from the ground it stands on (see ground.ts) and receives
// shadows but casts none.
loadingManager.addHandler(/\.glts$/i, gltsLoader);
const ground = groundColor();
const carried = ground.toVarying("vGrassGround");
const loader = new CachedLodLoader(loadingManager, {
  onLevel: (object) => {
    foliageLevels(object, { translucency: 0.5 });
    object.traverse((node) => {
      if (!(node instanceof THREE.Mesh)) return;
      const material = node.material;
      if (!(material instanceof THREE.MeshStandardNodeMaterial) || !material.colorNode) throw new Error("grass: its levels need their authored colour node");
      // An impostor already uses all the varyings WebGPU allows; it covers few pixels, so it reads the ground per pixel.
      material.colorNode = new THREE.ConvertNode<"vec4">(material.colorNode, "vec4").mul(vec4(node instanceof ImpostorMesh ? ground : carried, 1));
      node.castShadow = false;
      node.receiveShadow = true;
    });
  },
});
const LADDERS: Record<string, () => Promise<LodLevel[]>> = {
  "lawn 0": () =>
    loader.loadAsync({
      url: "./source.glts?kind=lawn&variant=0",
      levels: [
        { type: "impostor", layout: "hemi", resolution: 64 },
        { type: "empty", maxPixels: 1 },
      ],
    }),
  "lawn 1": () =>
    loader.loadAsync({
      url: "./source.glts?kind=lawn&variant=1",
      levels: [
        { type: "impostor", layout: "hemi", resolution: 64 },
        { type: "empty", maxPixels: 1 },
      ],
    }),
  "meadow 0": () =>
    loader.loadAsync({
      url: "./source.glts?kind=meadow&variant=0",
      levels: [
        { type: "impostor", layout: "hemi", resolution: 64 },
        { type: "empty", maxPixels: 1 },
      ],
    }),
  "meadow 1": () =>
    loader.loadAsync({
      url: "./source.glts?kind=meadow&variant=1",
      levels: [
        { type: "impostor", layout: "hemi", resolution: 64 },
        { type: "empty", maxPixels: 1 },
      ],
    }),
};
const query = new URL(import.meta.url).searchParams;
const kind = query.get("kind") ?? "lawn";
const variant = query.get("variant") ?? "0";
const load = LADDERS[`${kind} ${variant}`];
if (!load) throw new Error(`grass: kind must be lawn or meadow and variant 0 or 1, not ${kind} and ${variant}`);
const lod = new Lod(await load(), 1, { manager: loadingManager });
scene.add(lod);
onDispose(() => lod.dispose());
