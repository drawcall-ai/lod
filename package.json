    "lab": "pnpm --filter @drawcall/impostor-example-lab dev",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "@types/three": "^0.185.0",
    "prettier": "^3.9.6",
    "three": "0.185.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.17"
  }
}
